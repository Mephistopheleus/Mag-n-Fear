```gitignore
# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Compiled Python files
*.pyc
*.pyo
*.pyd
*.so
*.egg-info/

# Dependencies
venv/
.venv/
.env
.env.local
.env.*

# Logs
*.log

# Editors
.vscode/
.idea/
*.swp
*.swo

# Coverage
.coverage
coverage/
htmlcov/

# Distribution / packaging
dist/
build/
*.egg
*.whl
pip-log.txt
pip-delete-this-directory.txt

# Pytest
.pytest_cache/
```