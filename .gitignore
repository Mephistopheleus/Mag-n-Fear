```gitignore
# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Compiled Python files
*.pyc
*.pyo
*.pyd
*.so
*.egg-info/
dist/
build/
*.egg

# Environment files
.env
.env.local
.env.*
.venv/
venv/
ENV/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*.tmp

# Logs
*.log

# Coverage reports
.coverage
htmlcov/
.coverage.*
coverage.xml

# Testing
.pytest_cache/
.mypy_cache/
.hypothesis/

# OS generated files
.DS_Store
Thumbs.db
```